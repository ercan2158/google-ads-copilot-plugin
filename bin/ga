#!/usr/bin/env bash
# bin/ga — single shell wrapper around the `composio` CLI for Google Ads.
# Two subcommands: query (slug-based read via composio execute) and proxy
# (curl-like REST call via composio proxy, with the developer-token header
# attached). The only file in the plugin that touches `composio`. If
# Composio's CLI shape changes, fix here.

set -euo pipefail

SECRETS_HELPER="${SECRETS_HELPER:-$HOME/.config/secrets/get-secret.sh}"
GOOGLEADS_API_BASE="${GOOGLEADS_API_BASE:-https://googleads.googleapis.com}"

usage() {
  cat <<EOF >&2
Usage: ga <subcommand> [args]

Subcommands:
  query "<GAQL>"                              Run a read-only GAQL query.
  proxy <METHOD> <PATH> [<JSON-BODY>]         Proxy an arbitrary Google Ads
                                              REST call (mutations included).
                                              PATH is the path part only,
                                              e.g. /v23/customers:listAccessibleCustomers.

Examples:
  ga query "SELECT campaign.id, campaign.name FROM campaign LIMIT 5"
  ga proxy GET /v23/customers:listAccessibleCustomers
  ga proxy POST /v23/customers/8191097521/campaignCriteria:mutate '{"operations":[...]}'
EOF
  exit 64
}

unwrap() {
  # Composio's `execute` returns {"data":"<json-string-or-object>","successful":true}.
  # Unwrap to the inner data on success; emit error on failure (handling
  # both string and object error shapes).
  jq -e '
    if .successful != true then
      ("composio error: " + (
        if (.error | type) == "object" then (.error | tojson)
        else (.error // "unknown" | tostring)
        end
      )) | halt_error(1)
    elif (.data | type) == "string" then
      .data | fromjson
    else
      .data
    end
  '
}

cmd_query() {
  local q="${1:-}"
  [[ -z "$q" ]] && { echo "ga query: missing GAQL string" >&2; exit 64; }
  local payload
  payload=$(jq -nc --arg q "$q" '{query:$q}')
  composio execute GOOGLEADS_QUERY -d "$payload" | unwrap
}

cmd_proxy() {
  local method="${1:-}" path="${2:-}" body="${3:-}"
  [[ -z "$method" || -z "$path" ]] && {
    echo "ga proxy: need METHOD and PATH" >&2; exit 64
  }
  local dev_token full_url
  dev_token=$("$SECRETS_HELPER" google-ads DEVELOPER_TOKEN)
  full_url="${GOOGLEADS_API_BASE}${path}"

  local args=( proxy "$full_url" --toolkit googleads -X "$method" -H "developer-token: $dev_token" )
  if [[ -n "$body" && "$body" != "null" ]]; then
    args+=( -H "content-type: application/json" -d "$body" )
  fi
  composio "${args[@]}"
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    query) cmd_query "$@" ;;
    proxy) cmd_proxy "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "ga: unknown subcommand: $sub" >&2; usage ;;
  esac
}

main "$@"
