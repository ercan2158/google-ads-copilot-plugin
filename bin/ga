#!/usr/bin/env bash
# bin/ga — thin shell wrapper that activates the vendored venv, then invokes
# the Python client (bin/ga.py). Keeps the same CLI surface as the previous
# bash bin/ga so callers (bin/apply, skills, the agent) don't change.
#
# Two subcommands:
#   ga query "<GAQL>"                       Run a GAQL search via GoogleAdsService.search_stream
#   ga proxy <METHOD> <PATH> [<JSON-BODY>]  Send any REST call with auto-refreshed auth headers

set -euo pipefail

VENV_DIR="${GOOGLE_ADS_COPILOT_VENV:-$HOME/.local/share/google-ads-copilot/.venv}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [[ ! -x "$VENV_DIR/bin/python3" ]]; then
  {
    echo "ga: vendored venv not found at $VENV_DIR"
    echo "    Run \`bin/setup\` to create it (one-time, ~50MB google-ads install)."
  } >&2
  exit 1
fi

exec "$VENV_DIR/bin/python3" "$SCRIPT_DIR/ga.py" "$@"
