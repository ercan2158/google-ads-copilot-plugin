#!/usr/bin/env bash
# bin/ga — direct Google Ads REST API wrapper for the ads-copilot plugin.
# Two subcommands: query (GAQL search) and proxy (arbitrary REST). All calls
# attach a fresh OAuth access token (refreshed from the stored refresh_token
# every invocation), the developer token, and the login-customer-id.
#
# This is the only file in the plugin that calls `curl` against Google.
# Everything else (skills, commands, agent) goes through `bin/ga`.

set -euo pipefail

CREDENTIALS_FILE="${ADS_COPILOT_CREDENTIALS_FILE:-$HOME/.config/ads-copilot/credentials}"
GOOGLEADS_API_BASE="${GOOGLEADS_API_BASE:-https://googleads.googleapis.com}"
GOOGLEADS_API_VERSION="${GOOGLEADS_API_VERSION:-v23}"
OAUTH_TOKEN_URL="${OAUTH_TOKEN_URL:-https://oauth2.googleapis.com/token}"
TOKEN_CACHE="${ADS_COPILOT_TOKEN_CACHE:-$HOME/.cache/ads-copilot/access-token}"

# read_secret <KEY> — read a credential from the env or the credentials file.
# Env vars are checked first (GOOGLE_ADS_<KEY>), then the file at
# $CREDENTIALS_FILE in KEY=value format. Exits non-zero with a helpful
# message if neither is set.
read_secret() {
  local key="$1"
  local env_name="GOOGLE_ADS_${key}"
  local env_val="${!env_name:-}"
  if [[ -n "$env_val" ]]; then
    echo "$env_val"
    return 0
  fi
  if [[ ! -f "$CREDENTIALS_FILE" ]]; then
    {
      echo "ga: credentials file not found at $CREDENTIALS_FILE"
      echo "    Run \`bin/setup\` to create it, or set ${env_name} as an env var,"
      echo "    or override the path with ADS_COPILOT_CREDENTIALS_FILE."
    } >&2
    exit 1
  fi
  local value
  value=$(grep "^${key}=" "$CREDENTIALS_FILE" | head -1 | cut -d= -f2-)
  if [[ -z "$value" ]]; then
    echo "ga: ${key} missing from $CREDENTIALS_FILE (or set ${env_name} env var)" >&2
    exit 1
  fi
  echo "$value"
}

usage() {
  cat <<EOF >&2
Usage: ga <subcommand> [args]

Subcommands:
  query "<GAQL>"                        Run a GAQL search against the bound
                                        workspace's customer_id.
  proxy <METHOD> <PATH> [<JSON-BODY>]   Send an arbitrary REST call. PATH is
                                        a path-only string starting with /,
                                        e.g. /v23/customers:listAccessibleCustomers.

Examples:
  ga query "SELECT campaign.id, campaign.name FROM campaign LIMIT 5"
  ga proxy GET /v23/customers:listAccessibleCustomers
  ga proxy POST /v23/customers/8191097521/campaignCriteria:mutate '{"operations":[...]}'
EOF
  exit 64
}

# Walk up from PWD looking for workspace.json. Up to 5 levels. Echo absolute
# path to stdout on success; non-zero exit (silent) on failure — caller
# decides whether to print or fall back to env-var overrides.
find_workspace() {
  local dir="$PWD"
  local i
  for i in 1 2 3 4 5; do
    if [[ -f "$dir/workspace.json" ]]; then
      echo "$dir/workspace.json"
      return 0
    fi
    [[ "$dir" == "/" ]] && break
    dir=$(cd "$dir/.." && pwd)
  done
  return 1
}

get_access_token() {
  local now expires_at cached_token client_id client_secret refresh_token resp tok expires_in

  # Try cache first. Tokens are valid ~3600s; cache them with a 60s safety
  # margin so a daily/weekly review (8-15 calls in close succession) doesn't
  # do 8-15 token refreshes (~150-300ms each).
  if [[ -f "$TOKEN_CACHE" ]]; then
    expires_at=$(jq -r '.expires_at // 0' "$TOKEN_CACHE" 2>/dev/null || echo 0)
    cached_token=$(jq -r '.access_token // empty' "$TOKEN_CACHE" 2>/dev/null)
    now=$(date +%s)
    if [[ -n "$cached_token" && "$expires_at" =~ ^[0-9]+$ && "$expires_at" -gt $((now + 60)) ]]; then
      echo "$cached_token"
      return 0
    fi
  fi

  # Cache miss or expired — refresh.
  client_id=$(read_secret CLIENT_ID)
  client_secret=$(read_secret CLIENT_SECRET)
  refresh_token=$(read_secret REFRESH_TOKEN)

  resp=$(curl -sS -X POST "$OAUTH_TOKEN_URL" \
    --data-urlencode "client_id=$client_id" \
    --data-urlencode "client_secret=$client_secret" \
    --data-urlencode "refresh_token=$refresh_token" \
    --data-urlencode "grant_type=refresh_token")

  tok=$(echo "$resp" | jq -r '.access_token // empty')
  expires_in=$(echo "$resp" | jq -r '.expires_in // 0')
  if [[ -z "$tok" ]]; then
    {
      echo "ga: OAuth token refresh failed."
      echo "Response from $OAUTH_TOKEN_URL:"
      echo "$resp" | jq . 2>/dev/null || echo "$resp"
      echo
      echo "Most likely cause: the refresh_token in $CREDENTIALS_FILE"
      echo "was revoked or never set. Re-run \`bin/oauth-bootstrap\` to refresh it."
    } >&2
    exit 1
  fi

  # Persist for the next invocation. 600 perms — even though access tokens
  # are short-lived, exposing them via a world-readable cache is unnecessary.
  if [[ "$expires_in" =~ ^[0-9]+$ ]] && (( expires_in > 0 )); then
    mkdir -p "$(dirname "$TOKEN_CACHE")"
    expires_at=$(($(date +%s) + expires_in))
    jq -nc --arg tok "$tok" --argjson ea "$expires_at" \
      '{access_token: $tok, expires_at: $ea}' > "$TOKEN_CACHE"
    chmod 600 "$TOKEN_CACHE"
  fi

  echo "$tok"
}

# load_context populates global vars used by curl callers:
#   _GA_ACCESS_TOKEN, _GA_DEV_TOKEN, _GA_MGR_ID, _GA_CUSTOMER_ID
#
# Resolution order:
#   1. Walk up from cwd to find workspace.json (normal case).
#   2. Fall back to GA_CUSTOMER_ID / GA_MANAGER_CUSTOMER_ID env vars
#      (used by /ads-bootstrap before workspace.json exists, or for
#      ad-hoc one-off calls outside any workspace).
#   3. If neither, leave _GA_CUSTOMER_ID empty — cmd_query will error
#      clearly; cmd_proxy works fine for endpoints that don't need it
#      (e.g. /v23/customers:listAccessibleCustomers).
load_context() {
  local workspace_json
  if workspace_json=$(find_workspace); then
    _GA_CUSTOMER_ID=$(jq -re '.account.customer_id' "$workspace_json")
    _GA_MGR_ID=$(jq -r '.account.manager_customer_id // empty' "$workspace_json")
  else
    _GA_CUSTOMER_ID="${GA_CUSTOMER_ID:-}"
    _GA_MGR_ID="${GA_MANAGER_CUSTOMER_ID:-}"
  fi
  # Validate IDs are numeric (defense-in-depth: an attacker-controlled value
  # containing CRLF could inject curl -H headers; one containing / could alter
  # the URL path). Google Ads customer IDs are always 10-digit numeric strings.
  if [[ -n "$_GA_CUSTOMER_ID" && ! "$_GA_CUSTOMER_ID" =~ ^[0-9]+$ ]]; then
    echo "ga: invalid customer_id (must be numeric): $_GA_CUSTOMER_ID" >&2
    exit 1
  fi
  if [[ -n "$_GA_MGR_ID" && ! "$_GA_MGR_ID" =~ ^[0-9]+$ ]]; then
    echo "ga: invalid manager_customer_id (must be numeric): $_GA_MGR_ID" >&2
    exit 1
  fi
  _GA_DEV_TOKEN=$(read_secret DEVELOPER_TOKEN)
  _GA_ACCESS_TOKEN=$(get_access_token)
}

# build_header_args fills the global array _GA_HEADER_ARGS with -H pairs
# ready to pass directly to curl. Caller must call load_context first.
build_header_args() {
  _GA_HEADER_ARGS=(
    -H "Authorization: Bearer $_GA_ACCESS_TOKEN"
    -H "developer-token: $_GA_DEV_TOKEN"
    -H "Content-Type: application/json"
  )
  if [[ -n "$_GA_MGR_ID" ]]; then
    _GA_HEADER_ARGS+=( -H "login-customer-id: $_GA_MGR_ID" )
  fi
}

cmd_query() {
  local q="${1:-}"
  [[ -z "$q" ]] && { echo "ga query: missing GAQL string" >&2; exit 64; }

  local _GA_ACCESS_TOKEN _GA_DEV_TOKEN _GA_MGR_ID _GA_CUSTOMER_ID
  local _GA_HEADER_ARGS
  load_context
  if [[ -z "$_GA_CUSTOMER_ID" ]]; then
    echo "ga query: customer_id required — cd into a workspace, or set GA_CUSTOMER_ID=<id>" >&2
    exit 1
  fi
  build_header_args

  local url body
  url="${GOOGLEADS_API_BASE}/${GOOGLEADS_API_VERSION}/customers/${_GA_CUSTOMER_ID}/googleAds:search"
  body=$(jq -nc --arg q "$q" '{query:$q}')

  curl -sS -X POST "$url" "${_GA_HEADER_ARGS[@]}" -d "$body"
}

cmd_proxy() {
  local method="${1:-}" path="${2:-}" body="${3:-}"
  [[ -z "$method" || -z "$path" ]] && {
    echo "ga proxy: need METHOD and PATH" >&2; exit 64
  }

  local _GA_ACCESS_TOKEN _GA_DEV_TOKEN _GA_MGR_ID _GA_CUSTOMER_ID
  local _GA_HEADER_ARGS
  load_context
  build_header_args

  local url="${GOOGLEADS_API_BASE}${path}"

  if [[ -n "$body" && "$body" != "null" ]]; then
    curl -sS -X "$method" "$url" "${_GA_HEADER_ARGS[@]}" -d "$body"
  else
    curl -sS -X "$method" "$url" "${_GA_HEADER_ARGS[@]}"
  fi
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    query) cmd_query "$@" ;;
    proxy) cmd_proxy "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "ga: unknown subcommand: $sub" >&2; usage ;;
  esac
}

main "$@"
