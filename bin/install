#!/usr/bin/env bash
# bin/install — register the plugin with Claude Code and verify connectivity
# against Google Ads API (no Composio).

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PLUGIN_NAME="ads-copilot"
TARGET="$HOME/.claude/plugins/$PLUGIN_NAME"

# 1. Symlink the plugin into ~/.claude/plugins/
mkdir -p "$HOME/.claude/plugins"
if [[ -L "$TARGET" || -e "$TARGET" ]]; then
  echo "[install] removing existing $TARGET"
  rm -rf "$TARGET"
fi
ln -s "$REPO_DIR" "$TARGET"
echo "[install] linked $REPO_DIR -> $TARGET"

# 2. Sanity-check secrets file
SECRETS_FILE="$HOME/.config/secrets/google-ads/credentials"
if [[ ! -f "$SECRETS_FILE" ]]; then
  cat <<EOF >&2
[install] $SECRETS_FILE not found.

Create it with these keys (KEY=value, one per line):
  DEVELOPER_TOKEN=<from Google Ads API Center>
  CLIENT_ID=<from your OAuth 2.0 Desktop client in Google Cloud Console>
  CLIENT_SECRET=<same OAuth client>
  REFRESH_TOKEN=<run \`bin/oauth-bootstrap\` after creating the file>
EOF
  exit 1
fi
for key in DEVELOPER_TOKEN CLIENT_ID CLIENT_SECRET REFRESH_TOKEN; do
  if ! grep -q "^${key}=" "$SECRETS_FILE"; then
    echo "[install] missing $key in $SECRETS_FILE — see README/oauth-bootstrap" >&2
    exit 1
  fi
done

# 3. Run unit tests for bin/ga
echo "[install] running bin/test-ga.sh"
"$REPO_DIR/bin/test-ga.sh"

# 4. Live smoke test via the proxy path. If you have a workspace.json in cwd,
#    we'll use its customer/manager. Otherwise we cd into the home directory
#    and require the user to run install from inside a workspace folder for
#    the live test (or from anywhere if you want to skip it).
echo "[install] live smoke test: ga proxy GET /v23/customers:listAccessibleCustomers"
out=$("$REPO_DIR/bin/ga" proxy GET /v23/customers:listAccessibleCustomers 2>&1) || {
  echo "[install] FAILED — ga proxy errored:"
  echo "$out"
  echo
  echo "Likely fixes:"
  echo "  - Run \`bin/oauth-bootstrap\` if REFRESH_TOKEN is missing or revoked"
  echo "  - Verify all 4 keys in $SECRETS_FILE: DEVELOPER_TOKEN, CLIENT_ID, CLIENT_SECRET, REFRESH_TOKEN"
  exit 1
}

if echo "$out" | jq -e '.error // empty' >/dev/null 2>&1; then
  echo "[install] FAILED — Google Ads returned an error:"
  echo "$out" | jq .
  echo
  echo "Common causes:"
  echo "  - DEVELOPER_TOKEN_PROHIBITED — Cloud project mismatch. Your OAuth"
  echo "    client must be in the same Cloud project as the dev token."
  echo "  - PERMISSION_DENIED — dev token approval status (Test/Basic/Standard)"
  echo "    may not allow access to this account."
  echo "  - INVALID_DEVELOPER_TOKEN — token typo or wrong API Center."
  exit 1
fi

echo "[install] OK. Accessible customers:"
echo "$out" | jq .

cat <<'EOF'

[install] Done. Open Claude Code in any folder with a workspace.json
          and run /ads-daily to start.
EOF
