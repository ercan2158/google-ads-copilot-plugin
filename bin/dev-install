#!/usr/bin/env bash
# bin/dev-install — register the plugin with Claude Code via local marketplace
# (developer workflow only — end users use bin/setup instead). Verifies
# connectivity against the Google Ads API. Idempotent — safe to re-run.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SECRETS_FILE="${GOOGLE_ADS_COPILOT_CREDENTIALS_FILE:-$HOME/.config/google-ads-copilot/google-ads.yaml}"
LEGACY_SECRETS="$HOME/.config/google-ads-copilot/credentials"
VENV_DIR="${GOOGLE_ADS_COPILOT_VENV:-$HOME/.local/share/google-ads-copilot/.venv}"

step() { printf '\n[install] %s\n' "$*"; }
fail() { printf '[install] FAILED — %s\n' "$*" >&2; exit 1; }

# Same redaction as bin/setup — structured Google Ads errors only,
# truncate everything else to 200 chars.
print_safe_error() {
  if echo "$1" | jq -e '.error | type == "object"' >/dev/null 2>&1; then
    echo "$1" | jq '.error | {code, message, status, details}' >&2
  else
    echo "$1" | head -c 200 >&2
    echo "" >&2
  fi
}

# 1. Sanity-check secrets file ------------------------------------------------
step "checking $SECRETS_FILE"
if [[ ! -f "$SECRETS_FILE" ]]; then
  if [[ -f "$LEGACY_SECRETS" ]]; then
    fail "Legacy KEY=value credentials at $LEGACY_SECRETS detected. Run \`bin/setup\` first to migrate to google-ads.yaml."
  fi
  cat >&2 <<EOF
$SECRETS_FILE not found.

Create it (chmod 600) with at least three keys, then run \`bin/oauth-bootstrap\`,
then re-run this script:

  developer_token: <from Google Ads API Center>
  client_id: <your OAuth 2.0 Desktop client>
  client_secret: <same OAuth client>
  use_proto_plus: true
EOF
  exit 1
fi
if [[ ! -x "$VENV_DIR/bin/python3" ]]; then
  fail "vendored venv not found at $VENV_DIR — run \`bin/setup\` first to create it"
fi
"$VENV_DIR/bin/python3" - <<EOF || fail "credentials yaml validation failed"
import yaml, sys
data = yaml.safe_load(open("$SECRETS_FILE")) or {}
needed = ("developer_token", "client_id", "client_secret", "refresh_token")
missing = [k for k in needed if not data.get(k)]
if "refresh_token" in missing and len(missing) == 1:
    print("refresh_token missing — run bin/oauth-bootstrap then re-run", file=sys.stderr)
    sys.exit(1)
if missing:
    print(f"missing keys in $SECRETS_FILE: {missing}", file=sys.stderr)
    sys.exit(1)
EOF
step "credentials OK (developer_token, client_id, client_secret, refresh_token present)"

# 2. Run unit tests -----------------------------------------------------------
step "running bin/test-ga.sh"
"$REPO_DIR/bin/test-ga.sh"

step "running bin/test-apply.sh"
"$REPO_DIR/bin/test-apply.sh"

# 3. Register the marketplace + install the plugin (both idempotent) ---------
step "registering Claude Code marketplace + plugin (idempotent)"
if ! command -v claude >/dev/null; then
  fail "\`claude\` CLI not on PATH. Install Claude Code first."
fi
claude plugin marketplace add "$REPO_DIR" 2>&1 | tail -1
claude plugin install google-ads-copilot@google-ads-copilot 2>&1 | tail -1

# 4. Live smoke test ----------------------------------------------------------
step "live smoke test: bin/ga proxy GET /v23/customers:listAccessibleCustomers"
out=$("$REPO_DIR/bin/ga" proxy GET /v23/customers:listAccessibleCustomers 2>&1) || {
  print_safe_error "$out"
  fail "ga proxy errored. Likely fixes:
  - Run \`bin/oauth-bootstrap\` if REFRESH_TOKEN was revoked
  - Re-check $SECRETS_FILE has all 4 keys"
}

if echo "$out" | jq -e '.error // empty' >/dev/null 2>&1; then
  print_safe_error "$out"
  fail "Google Ads returned an error. Common causes:
  - DEVELOPER_TOKEN_PROHIBITED — your dev token's Cloud project must
    match the OAuth client's Cloud project
  - PERMISSION_DENIED — dev token approval (Test/Basic/Standard) gap
  - INVALID_DEVELOPER_TOKEN — token typo or wrong API Center"
fi

step "OK. Accessible customers:"
echo "$out" | jq .

cat <<'EOF'

[install] Done. RESTART Claude Code to load the plugin, then:
            cd <a folder with a workspace.json>
            claude
            > /ads-daily
EOF
